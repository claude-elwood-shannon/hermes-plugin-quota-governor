#!/usr/bin/env bash
# opencode-go-quota — OpenCode Go usage summary.
# Usage: opencode-go-quota [raw|json|summary]
# Default output: human-readable summary (three lines with percent + reset).
#
# MULTI-PROV-06: OpenCode Go rejects Tor exit nodes (same as Ollama and
# NanoGPT), so proxy env vars are unset for the duration of the call.
# The API key is sourced from the pr-opencode profile .env.

set -euo pipefail

PROFILE="${HERMES_PROFILE:-pr-opencode}"
ENV_FILE="$HOME/.hermes/profiles/$PROFILE/.env"

# Fall back to pr-opencode explicitly — the key only lives there.
if [[ ! -f "$ENV_FILE" && "$PROFILE" != "pr-opencode" ]]; then
    ENV_FILE="$HOME/.hermes/profiles/pr-opencode/.env"
fi

if [[ ! -f "$ENV_FILE" ]]; then
    echo "ERROR: env file not found at $ENV_FILE" >&2
    exit 1
fi

# shellcheck disable=SC1090
source "$ENV_FILE"

if [[ -z "${OPENCODE_GO_API_KEY:-}" ]]; then
    echo "ERROR: OPENCODE_GO_API_KEY not set in $ENV_FILE" >&2
    exit 1
fi

# Unset proxy vars for the call (OpenCode Go rejects Tor).
unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY all_proxy ALL_PROXY

RAW=$(curl -s -m 15 \
    -H "Authorization: Bearer $OPENCODE_GO_API_KEY" \
    -H "x-opencode-session: $(python3 -c 'import uuid; print(uuid.uuid4())')" \
    https://opencode.ai/zen/go/v1/usage)

case "${1:-summary}" in
    raw)
        echo "$RAW"
        ;;
    json)
        echo "$RAW" | python3 -m json.tool
        ;;
    summary|*)
        echo "$RAW" | python3 -c "
import sys, json

d = json.load(sys.stdin)
usage = d.get('usage', {})


def fmt(window_name, label):
    w = usage.get(window_name, {})
    pct = w.get('percent')
    reset = w.get('resetsAt')
    status = w.get('status')
    if pct is None:
        print(f'{label}:  sin datos')
        return
    line = f'{label}: {pct:5.1f}% usado'
    if status and status != 'ok':
        line += f'  (estado: {status})'
    if reset:
        line += f'  (resetea {reset})'
    print(line)


fmt('rolling', 'Rolling')
fmt('weekly', 'Semanal')
fmt('monthly', 'Mensual')
"
        ;;
esac
