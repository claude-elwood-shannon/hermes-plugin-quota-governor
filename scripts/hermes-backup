#!/bin/bash
# hermes-backup: restic backup of Hermes state to S3-compatible storage
# Cron: every 3 hours (0 */3 * * *) — data loss window <= 3h
# Retention: keep 4 hourly / 7 daily / 4 weekly, --group-by '' (no grouping)
# Log: ~/.hermes/logs/backup.log
#
# t_6c5233a8 (MEDIATOR 2026-09-14) — gaps patched:
#   - Gap 1/2: memories/ and docs/ of EVERY existing profile (not recreable)
#   - Gap 3: audit-trail files inside logs/ (objective-events.jsonl,
#     vllm-invoke.jsonl, cron-health-check.jsonl, efficiency-ratio.log) —
#     specific paths only, NOT the whole logs/ dir
#   - Gap 5: `git push --all` of the plugin repo BEFORE the snapshot
#     (WARNING and continue if it fails) + the repo itself backed up as
#     double protection (GitHub + restic)
#   - RESTIC_REPOSITORY comes from the private env file — the GitHub repo
#     is public, so the S3 endpoint/bucket is NEVER versioned here. If the
#     env file does not set it, abort with ERROR.
#   - ERROR/WARNING markers are actually emitted on failure (set -e made
#     the old handlers dead code; /backup/health greps these markers).
#
# Security: this file must never contain RESTIC_PASSWORD, S3 credentials,
# endpoint or bucket names (house rule: public repo).

set -euo pipefail

ENV_FILE="$HOME/.config/restic-hermes/env"
LOG_FILE="$HOME/.hermes/logs/backup.log"
PLUGIN_REPO="/data/git/hermes-plugin-quota-governor"

# Source credentials + RESTIC_REPOSITORY (private env file, chmod 600)
if [ ! -f "$ENV_FILE" ]; then
    echo "ERROR: env file not found at $ENV_FILE" | tee -a "$LOG_FILE"
    exit 1
fi
# shellcheck disable=SC1090
source "$ENV_FILE"
if [ -z "${RESTIC_REPOSITORY:-}" ]; then
    echo "ERROR: RESTIC_REPOSITORY not set by $ENV_FILE" >> "$LOG_FILE"
    exit 1
fi

# Paths to back up
BACKUP_PATHS=(
    "$HOME/.hermes/kanban.db"
    "$HOME/.hermes/profiles/pr-ollama/skills"
    "$HOME/.hermes/profiles/pr-ollama/memories"
    "$HOME/.hermes/profiles/pr-ollama/state.db"
    "$HOME/.hermes/profiles/pr-ollama/docs"
    # Cron job definitions (guardrail prompts live here — gap fixed Sep 7 2026)
    "$HOME/.hermes/profiles/pr-ollama/cron"
    # Deployed governor scripts (quota-gate.py etc. — cron resolves them here)
    "$HOME/.hermes/profiles/pr-ollama/scripts"
    # Governor state: observations, proposals, autopromote ledger, STOP files
    "$HOME/.hermes/profiles/pr-ollama/quota-governor"
    # Other profiles: their own crons (jobs.json = guardrail prompts), scripts, config
    "$HOME/.hermes/profiles/pr-nanogpt/cron"
    "$HOME/.hermes/profiles/pr-nanogpt/scripts"
    "$HOME/.hermes/profiles/pr-nanogpt/config.yaml"
    "$HOME/.hermes/profiles/pr-opencode/cron"
    "$HOME/.hermes/profiles/pr-opencode/scripts"
    "$HOME/.hermes/profiles/pr-opencode/config.yaml"
    # Shared governor state (autopromote ledger, PROMOTE-STOP, orchestrator state)
    "$HOME/.hermes/quota-governor"
    "$HOME/.hermes/scripts"
    # Global assets shared across profiles
    "$HOME/.hermes/skills"
    "$HOME/.hermes/config.yaml"
)

# Gaps 1+2: memories/ and docs/ of every profile that has them
for prof_dir in "$HOME"/.hermes/profiles/*/; do
    for sub in memories docs; do
        d="${prof_dir}${sub}"
        [ -d "$d" ] && BACKUP_PATHS+=("$d")
    done
done

# Gap 3: audit trails (specific paths, not the whole logs/ dir)
for f in "$HOME/.hermes/logs/objective-events.jsonl" \
         "$HOME/.hermes/logs/vllm-invoke.jsonl" \
         "$HOME/.hermes/logs/cron-health-check.jsonl" \
         "$HOME/.hermes/logs/efficiency-ratio.log"; do
    [ -f "$f" ] && BACKUP_PATHS+=("$f")
done

# Gap 5: plugin repo as double protection (GitHub + restic)
[ -d "$PLUGIN_REPO" ] && BACKUP_PATHS+=("$PLUGIN_REPO")

TAGS="--tag hermes-pr-ollama"
TIMESTAMP=$(date +"%Y-%m-%d %H:%M:%S")

echo "=== Backup started: $TIMESTAMP ===" >> "$LOG_FILE"

# Gap 5: push all branches to GitHub BEFORE the snapshot, so every commit
# is durable off-host before restic runs. On failure: WARNING and continue
# (the local repo is still snapshotted). Full push output discarded — it
# may contain host paths or remote names; only the exit status is logged.
PUSH_ERR=""
if git -C "$PLUGIN_REPO" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    timeout 120 git -C "$PLUGIN_REPO" push --all >/dev/null 2>&1 || PUSH_ERR=$?
    if [ -n "$PUSH_ERR" ]; then
        echo "WARNING: git push --all failed (exit $PUSH_ERR); continuing with restic snapshot" >> "$LOG_FILE"
    fi
else
    echo "WARNING: plugin repo not found at $PLUGIN_REPO; skipping git push" >> "$LOG_FILE"
fi

# Run backup (condition context so the ERROR marker is really written)
if restic backup "${BACKUP_PATHS[@]}" $TAGS >> "$LOG_FILE" 2>&1; then
    :
else
    BACKUP_EXIT=$?
    echo "ERROR: backup failed with exit code $BACKUP_EXIT" >> "$LOG_FILE"
    exit "$BACKUP_EXIT"
fi

# Retention: keep a policy instead of only last N:
#   last 4 hourly  (~12h at 3h cadence — intraday recovery)
#   last 7 daily   (a week of daily-recoverable state)
#   last 4 weekly  (a month)
# --group-by '' disables grouping so all snapshots count together
# (without it, retention is applied per-tag-group which keeps way more than N)
restic forget --keep-hourly 4 --keep-daily 7 --keep-weekly 4 --group-by '' --prune >> "$LOG_FILE" 2>&1 \
    || echo "WARNING: forget/prune failed with exit code $?" >> "$LOG_FILE"

# Integrity check (metadata only; --read-data is a monthly manual drill)
restic check >> "$LOG_FILE" 2>&1 \
    || echo "WARNING: integrity check failed with exit code $?" >> "$LOG_FILE"

echo "=== Backup completed: $(date +"%Y-%m-%d %H:%M:%S") ===" >> "$LOG_FILE"
echo "" >> "$LOG_FILE"
